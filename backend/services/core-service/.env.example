# Copier ce fichier en ".env" et ajuster les valeurs selon l'environnement
# (dev local, production). ".env" ne doit JAMAIS être commité
# (il contient des secrets) — seul ce modèle documenté l'est. Toutes les
# valeurs ci-dessous sont celles par défaut de app/config.py, sauf mention.

# development | staging | production. Hors "development", le service REFUSE
# de démarrer avec la clé JWT d'exemple ou un CORS ouvert à tous.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Charger NLLB/Whisper/MMS au démarrage (plusieurs Go de RAM). Sur une machine
# à 8 Go, mettre false pour travailler sur le reste de l'API : l'assistant
# texte en français, la base de connaissances, l'espace agent, l'annuaire et
# les statistiques fonctionnent sans modèle ; la voix et le mooré/dioula
# répondent alors 503.
LOAD_MODELS_ON_STARTUP=true

# --- Base de données ---
# SQLite en local (zéro serveur). En production, une URL PostgreSQL
# (voir docs/DEPLOY.md).
DATABASE_URL=sqlite:///./dev.db

# --- Sécurité ---
# Générer une vraie valeur pour tout environnement autre que le dev local :
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme-dev-only-insecure-secret
JWT_ALGORITHM=HS256
# Durée de vie des jetons du personnel (agents, validateurs, admins), en minutes.
JWT_EXPIRE_MINUTES=60
# Durée de vie des jetons "appareil" des femmes (comptes anonymes), en jours.
# Renouvelables par POST /auth/device/recover.
DEVICE_TOKEN_EXPIRE_DAYS=30

# Domaines autorisés à appeler l'API depuis un navigateur (format JSON).
# "*" est refusé hors développement : indiquer l'app web et la console admin.
CORS_ALLOWED_ORIGINS=["*"]

# --- Administration ---
# Emails des premiers admins, créés par `python -m app.bootstrap_admin`
# (un e-mail, ou plusieurs séparés par des virgules). Vide = personne n'est admin.
ADMIN_EMAILS=[]
# Mot de passe du premier admin, lu UNIQUEMENT par `python -m app.bootstrap_admin`
# (10 caractères minimum). Laisser commenté pour qu'il soit demandé au clavier
# (recommandé) ; ne jamais le laisser dans un .env partagé.
# ADMIN_BOOTSTRAP_PASSWORD=

# --- Assistant ---
# Score de similarité minimal (0..1) pour servir une réponse validée.
ASSISTANT_MIN_CONFIDENCE=0.55
# Message quand aucune réponse validée ne correspond, par langue (JSON).
# Ajouter "mos"/"dyu" UNIQUEMENT avec un texte écrit et relu par des
# locuteurs natifs ; à défaut, le message français est renvoyé.
ASSISTANT_FALLBACK_MESSAGES={"fr": "Demandez à votre agent de santé"}
# Sert aussi le contenu `sourced` créé par `python -m app.seed` (OMS, UNFPA,
# relu par AUCUNE sage-femme), toujours signalé `provisional: true`. Pour une
# démo uniquement : laisser false pour un vrai pilote tant que ce contenu n'est
# pas validé dans la console.
SERVE_SOURCED_CONTENT=false
# Taille maximale d'un fichier audio envoyé (octets) : 10 Mo.
MAX_AUDIO_UPLOAD_BYTES=10485760
# Dossier des fichiers audio servis sous /media (enregistrements humains et
# synthèses MMS-TTS mises en cache). En production : un disque persistant.
MEDIA_DIR=./media

# --- Carnet de santé ---
# Taille maximale du chiffré de sauvegarde (octets, après décodage) : 5 Mo.
MAX_BACKUP_BYTES=5242880

# --- Statistiques publiques ---
# Toute cellule de compte inférieur à ce seuil est supprimée.
PUBLIC_STATS_MIN_COUNT=10

# --- Traçage distribué ---
# true UNIQUEMENT si un collecteur OpenTelemetry (Jaeger...) écoute à l'adresse
# ci-dessous.
TRACING_ENABLED=false
OTEL_EXPORTER_ENDPOINT=http://localhost:4317
SERVICE_NAME=laafi-ma-core
